# === REQUIRED ===
GEMINI_API_KEY=your_gemini_api_key_here

# === OPTIONAL (defaults shown) ===
PORT=3000
DATA_DIR=./data

# Viettel Product API (leave empty for built-in mock)
VIETTEL_PRODUCT_API_URL=

# Processing
MAX_CONCURRENT_API_CALLS=5
API_RETRY_COUNT=3

# Display
DASHBOARD_REFRESH_SECONDS=30
